# Copy to .env.local. Never commit .env.local.
# Same Supabase project as weeon-tenants (dashboard name: weeon-school).

SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server-only. Used to look up roster usernames and create Auth on first login.
# Never expose via NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Used to send the branded password-reset email via Resend.
# Never expose via NEXT_PUBLIC_*. Keep RESEND_API_KEY in sync with the other repos
# that send email (weeon-tenants, weeon-marketing). The sending domain
# @weeon.school is DKIM-verified — do not send from a free/third-party domain.
# RESEND_API_KEY=
# RESEND_FROM=Weeon Docentes <no-responder@weeon.school>

# Public origin of this app. Production: https://teachers.weeon.school
# WEEON_TEACHERS_ORIGIN=https://teachers.weeon.school

# Server-only. Grammar/spelling check (LanguageTool). Leave unset to use the
# public API (api.languagetool.org). Point at a self-hosted instance to keep
# teacher text on our infra — recommended for a school product.
# LANGUAGETOOL_URL=http://localhost:8010
# LANGUAGETOOL_API_KEY=
